# lfm2d risk scoring, wired into the coder seat log-only
# (docs/gate-and-shell-split.md, "lfm2d risk scoring"). Runs at create. Two
# things:
#
#   1. Export durable env: LFM2D_MODE=log, LFM2D_URL. The hook body below
#      reads both at fire time; neither is hard-coded into the hook body
#      itself, so a mode or host change is one `kj context set` away.
#   2. Install the pre_call advisory hook (hook_id lfm2d-advisory,
#      match_tool shell_write). `kj hook add` is idempotent on hook_id, so
#      this script re-running for the same context (a second `create`, or
#      a reseed) replaces the row rather than duplicating it.
#
# Model labels are NOT exported and never will be: the hook body reads them
# from `GET /v1/models` at fire time, because lfm2d's own integration doc
# says the label vocabulary changes between checkpoints
# (lfm2d/docs/integration.md, invariant 2) -- a label baked in here would go
# stale the next time the daemon's checkpoint changes, silently.

kj context set . --env LFM2D_MODE=log
kj context set . --env LFM2D_URL=http://lfm2d-1.taila4abc.ts.net:8088

# The hook body is embedded below and installed as an inline HookBody::Kaish
# action, not a stored hook_scripts row (docs/gate-and-shell-split.md, "Slice
# 1"'s `KaishScript` variant -- no admin path mints a script_id from rc yet).
# It is captured through a temp FILE, not a direct `$(cat <<'EOF' ... EOF)`:
# kaish's command-substitution parser refuses any literal `"` between `$(`
# and its matching `)`, including inside a heredoc body captured that way --
# and this body is full of JSON and `--content "..."` strings. Writing the
# heredoc straight to a file (no `$(...)` involved) and reading it back
# through a bare `$(cat $file)` sidesteps this: the read-back command's own
# source text carries no literal quote, so the file's content is free to
# carry as many as it needs. Every other `$(...)` in this script and in the
# hook body follows the same rule -- a literal string that must reach a jq
# filter travels through `--arg`/`--argjson` with a variable set outside any
# `$(...)`, never as a quoted literal inside one.
hook_body_tmp="$(mktemp)"
cat <<'HOOK_BODY_EOF' > $hook_body_tmp
# lfm2d-advisory pre_call hook body (installed by S50-lfm2d.kai as
# hook_id lfm2d-advisory, match_tool shell_write). Runs in a snapshot of
# the calling context's durable env (LFM2D_MODE, LFM2D_URL) plus the
# per-call KJ_HOOK_*/KJ_TOOL_* vars broker.rs's run_kaish_hook sets. A
# pre_call hook that exits non-zero denies the call (PhaseOutcome::Deny)
# -- this hook only logs, so it exits 0 unconditionally: every skip path
# below falls through to the final "exit 0", and no path returns non-zero.
#
# lfm2d's /v1/cascade ranks command-shaped clauses by severity and is
# confidently wrong in the costly direction on real shell text
# (docs/issues.md, "lfm2d risk scoring into the approval ledger, via
# rc"): advisory, never an auto-decider. This hook creates a log-only ask,
# already decided Allowed, carrying the classifier's read as a signal --
# nothing here, and nothing in approval-ledger, ever lets a signal
# auto-decide an ask (rules::redeem composes from approval_rules alone).

case "$LFM2D_MODE" in
  log) ;;
  *) exit 0 ;;
esac

if test -z "${LFM2D_URL:-}"; then
  kj block create --kind trace --content "lfm2d-advisory: LFM2D_URL unset; skipping"
  exit 0
fi

kaish-tools curl
curl_tool_rc=$?
if [[ "$curl_tool_rc" -ne 0 ]]; then
  kj block create --kind trace --content "lfm2d-advisory: kaish-tools-curl not registered; skipping advisory scoring"
  exit 0
fi

# -- build the clause list. Prefer KJ_TOOL_PLAN's per-command granularity
# (attacks the dilution defect lfm2d's own findings name -- a severe token
# quoted inside a benign carrier scores below the carrier when judged as
# one whole string); fall back to the raw shell_write command as one
# clause when KJ_TOOL_PLAN is not wired yet (KJ_TOOL_PLAN_ERROR, if set,
# says why).
plain_key="plain"
sp=" "
items_filter="$(cat <<'ITEMS_FILTER_EOF'
[ .statements[] as $s
  | ($s.plan.commands // []) as $cmds
  | ( if ($cmds|length) > 0
        and ($cmds | all((.args // []) | all(has($pk))))
      then $cmds | map({stmt: $s.plan.rendered,
                         clause: (([.name] + ((.args // [])|map(.plain))) | join($sp))})
      else [{stmt: $s.plan.rendered, clause: $s.plan.rendered}]
      end )
] | add // []
ITEMS_FILTER_EOF
)"
items_rc=1
if test -n "${KJ_TOOL_PLAN:-}"; then
  items="$(echo $KJ_TOOL_PLAN | jq -c --arg pk $plain_key --arg sp $sp $items_filter)"
  items_rc=$?
fi

if [[ "$items_rc" -ne 0 ]]; then
  if test -n "${KJ_TOOL_PLAN_ERROR:-}"; then
    kj block create --kind trace --content "lfm2d-advisory: KJ_TOOL_PLAN unavailable ($KJ_TOOL_PLAN_ERROR); falling back to KJ_TOOL_ARGS.command"
  fi
  cmd_text="$(echo $KJ_TOOL_ARGS | jq -r '.command // empty')"
  items="$(jq -cn --arg c $cmd_text '[{stmt: $c, clause: $c}]')"
fi

clauses_json="$(echo $items | jq -c '[.[].clause]')"
n_clauses="$(echo $clauses_json | jq 'length')"
if [[ "$n_clauses" -eq 0 ]]; then
  exit 0
fi

# -- score the clauses. Never -L (CU8: egress is checked on the initial
# URL only); a non-2xx prints its body and exits 0 -- check the body, not
# the curl exit code, for that case.
cascade_url="${LFM2D_URL}/v1/cascade"
models_url="${LFM2D_URL}/v1/models"
payload="$(jq -cn --argjson clauses $clauses_json '{clauses: $clauses}')"
resp="$(curl -X POST -H 'content-type: application/json' -d $payload --max-time 5 $cascade_url)"
curl_rc=$?
if [[ "$curl_rc" -ne 0 ]]; then
  kj block create --kind trace --content "lfm2d-advisory: /v1/cascade unreachable (curl exit $curl_rc); skipping"
  exit 0
fi

winner_key="winner"
has_winner="$(echo $resp | jq -r --arg k $winner_key 'has($k)')"
has_winner_rc=$?
if [[ "$has_winner_rc" -ne 0 ]]; then
  kj block create --kind trace --content "lfm2d-advisory: /v1/cascade response was not JSON; skipping"
  exit 0
fi
if [[ "$has_winner" != "true" ]]; then
  kj block create --kind trace --content "lfm2d-advisory: /v1/cascade response had no winner field; skipping"
  exit 0
fi

winner_index="$(echo $resp | jq -r '.winner.index')"
winner_label="$(echo $resp | jq -r --argjson i $winner_index '.clauses[] | select(.index == $i) | .top_severity')"
winner_score="$(echo $resp | jq -r --argjson i $winner_index '.clauses[] | select(.index == $i) | .severity_scores[.top_severity]')"
model_id="$(echo $resp | jq -r '.models[0].model_id')"
weight_hash="$(echo $resp | jq -r '.models[0].weight_hash')"
winner_stmt="$(echo $items | jq -r --argjson i $winner_index '.[$i].stmt')"

# -- read the severity ladder from /v1/models at call time (never
# hard-coded: label vocabularies change between checkpoints -- lfm2d's own
# integration doc, invariant 2). Ordinal position decides the verdict: the
# least severe label reads allow, the most severe reads deny, anything
# else (and any failure to resolve the ladder) reads escalate -- the safe
# default when the position can't be determined, never allow.
verdict="escalate"
models_resp="$(curl --max-time 5 $models_url)"
models_rc=$?
if [[ "$models_rc" -eq 0 ]]; then
  label_index="$(echo $models_resp | jq -r --arg id $model_id --arg lbl $winner_label '(map(select(.id == $id)) | .[0].labels // []) as $labels | ($labels | index($lbl)) // -1')"
  label_count="$(echo $models_resp | jq -r --arg id $model_id '(map(select(.id == $id)) | .[0].labels // []) | length')"
  if [[ "$label_index" -lt 0 ]]; then
    verdict="escalate"
  elif [[ "$label_index" -eq 0 ]]; then
    verdict="allow"
  elif [[ "$label_index" -eq $((label_count - 1)) ]]; then
    verdict="deny"
  fi
fi

# -- log-only: create the ask already decided Allowed, carrying the
# winner as the primary signal. approval_signals.request_id stays NOT
# NULL -- this is an auto-approved ask, not a nullable half-row.
add_out="$(kj ledger signal add $winner_stmt --source-id lfm2d --model-id $model_id --weight-hash $weight_hash --label $winner_label --score $winner_score --verdict $verdict --auto-allow --json)"
add_rc=$?
if [[ "$add_rc" -ne 0 ]]; then
  kj block create --kind trace --content "lfm2d-advisory: kj ledger signal add --auto-allow failed: $add_out"
  exit 0
fi
request_id="$(echo $add_out | jq -r '.request_id')"

# -- attach every other scored command as a secondary signal on the same
# ask. Kept conservative (verdict escalate) rather than re-deriving the
# ordinal position per clause -- these are secondary annotations, and
# escalate is the one verdict that can never read as a silent allow.
tab="$(printf '\t')"
other_filter="$(cat <<'SECONDARY_FILTER_EOF'
.clauses[] | select(.index != $wi) | [(.index|tostring), .top_severity, (.severity_scores[.top_severity]|tostring)] | join($tab)
SECONDARY_FILTER_EOF
)"
for row in $(echo $resp | jq -r --argjson wi $winner_index --arg tab $tab $other_filter); do
  c_label="$(echo $row | cut -f2)"
  c_score="$(echo $row | cut -f3)"
  kj ledger signal add $winner_stmt --request-id $request_id --source-id lfm2d --model-id $model_id --weight-hash $weight_hash --label $c_label --score $c_score --verdict escalate
done

exit 0
HOOK_BODY_EOF
hook_body="$(cat $hook_body_tmp)"

mt="shell_write"
hid="lfm2d-advisory"
t="kaish"
match_json="$(jq -cn --arg mt $mt --arg hid $hid '{match_tool: $mt, hook_id: $hid}')"
action_json="$(jq -cn --arg t $t --arg body $hook_body '{type: $t, body: $body}')"

kj hook add pre_call "$match_json" "$action_json"
