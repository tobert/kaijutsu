# companion: the main seat's loadout. Every tool schema rides on every
# request, so the roster is the seat's largest cost. Add a line here, then
# `kj context rotate`, to give the seat a tool.
set -e
# The writable shell. `gate.toml` allows `kj handoff note` for every type and
# covers anything else this seat runs under `[context_type.companion]`; a
# statement no key covers asks the person.
kj binding allow "facade:shell_write"
# The person's input surfaces in this context: compose edits, submit, capture.
kj binding allow "facade:edit_input"
kj binding allow "facade:submit_input"
kj binding allow "facade:commit_capture"
kj binding allow "editor"
# Deliberately NOT granted: fork, exec, transport, house, operator, system.
# The check-in clock belongs to the person. This seat does not set its own
# schedule.
