# senpai: orchestration and execution loadout, narrowed from house admin.
# Carries worker tools plus the `senpai` capability for direct-kohai
# lifecycle, asks, and driving; drifts kernel-admin requests to banto.
set -e
kj binding allow "facade:shell"
kj binding allow "builtin.file"
kj binding allow "builtin.tasks"
# Direct-kohai orchestration (`kj context create/rotate/archive`, `kj drive`,
# `kj interrupt`, `kj ledger`, `kj character list/show`) without `house` or
# `operator`.
kj binding allow "senpai"
kj binding allow "drive"
kj binding allow "fork"
kj binding allow "drift"
kj binding allow "exec"
kj binding allow "editor"
