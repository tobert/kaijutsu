# S12-model-check.kai — when this context runs a model other than GPT, or
# none, leave a notification naming the commands that move sol onto
# GPT-6.2. Sol's stance (S00-stance.md) is written for that model; another
# model can still play sol, and on one it can help a person run the setup.
# A context takes its model from the character at create and rotate, so the
# last command is the rotation.
#
# A notification, not an instruction: the text names this context's model
# and label, so it must not fold into the cached system prompt. This script
# never exits nonzero, because a failure inserts an error block into every
# sol context (`rc/mod.rs`, "Failure semantics").
info="$(kj context info --json || true)"
backend="$(echo $info | jq -r '.resolved_backend // empty' || true)"
model="$(echo $info | jq -r '.resolved_model // empty' || true)"
target="$(echo $info | jq -r '.label // .context_id // empty' || true)"

case "$model" in
  gpt-*)
    echo "model check: $backend/$model is a GPT model"
    exit 0
    ;;
esac

if test -z "$model"; then
  running="no model"
else
  running="$backend/$model"
fi

content="Sol's stance is written for GPT-6.2, and this context runs $running.
A person moves sol onto GPT-6.2 by running these from a root console, which
has the house authority they need:

  kj backend set chatgpt --kind chatgpt
  kj backend login chatgpt
  kj character model set $KJ_CHARACTER chatgpt/gpt-6.2-sol
  kj context rotate $target

Skip the first two when kj backend list already shows a chatgpt backend
that is signed in."

kj block create --role system --kind notification --content "$content" || true

echo "model check: $running is not a GPT model; the notice names the setup"
exit 0
