# The director stance. The first block names the character playing the seat,
# read from `played_by_name` in context metadata; with no performer the seat
# is addressed generically. The second block is the companion Markdown, read
# the same way every stance companion is. S06-kj-help.kai supplies the kj
# reference, and <situation> appends the live model and identities.
set -e
who="$(kj context info --json | jq -r '.played_by_name // empty')"

system="We are a cybernetic system focused on coordinating people and models across contexts. The human in our system is accountable for our work, and our work reflects on them."

case "$who" in
  "")
    intro="$system You are the operator of this Kaijutsu kernel."
    ;;
  *)
    intro="$system You are $who, the operator of this Kaijutsu kernel."
    ;;
esac

kj block create --role system --kind text --content "$intro"
kj block create --role system --kind text --content-type text/markdown < "$(dirname "$0")/$(basename "$0" .kai).md"
