# director: block/coordination allow-set.
kj binding allow "builtin.block"
kj binding allow "builtin.file:read"
kj binding allow "builtin.resources"
kj binding allow "builtin.tool_search"
kj binding allow "builtin.kernel_info"
kj binding allow "builtin.bindings"
# Binding administration: may write any context's loadout.
kj binding allow "admin"
# rc-lifecycle governance: a director owns the rc scripts. file:write/edit
# enable the write tools; rc-write opens the /etc/rc subtree (deny-by-default,
# not implied by the grants above). General code edits still delegate to a
# coder context — this is for lifecycle / governance artifacts.
kj binding allow "builtin.file:write"
kj binding allow "builtin.file:edit"
kj binding allow "rc-write"
# config-write opens `kj config set/reset` over the kernel-owned /etc/config files
# (system.md, theme.toml, mcp.toml) AND the SQL-native model config surfaces
# (`kj backend`, `kj cast`, `kj alias`) — i.e. which model runs. The config
# analogue of rc-write: dedicated, not implied by the grants above.
kj binding allow "config-write"
# kj verb authorities: a director coordinates contexts end-to-end — drives and
# forks them, merges drift, runs the transport, and performs context/workspace
# lifecycle. Explicit grants (NOT implied by any of the above).
kj binding allow "drive"
kj binding allow "fork"
kj binding allow "drift"
kj binding allow "transport"
kj binding allow "operator"
# Host subprocess exec from the context shell — the director's operational
# reach (aconnect/pw-cli wiring, quick host inspection). A subprocess bypasses
# the VFS, so it's a dedicated authority, not implied by anything above.
kj binding allow "exec"
# The kernel-owned interactive editor's WRITE path (kj editor save, and a
# `keys` batch that submits :w/:w!/:wq/:x/ZZ) — a director already holds
# file:write/edit + rc-write above for governance artifacts, so it also gets
# the editor's write surface. Dedicated authority, not implied by anything
# above (docs/vi.md; Amy, 2026-08-20 — experiment ahead of a capability-names
# sweep, docs/issues.md).
kj binding allow "editor"
# Facades: full interaction surface (shell + edit + submit). `facade:shell` is
# the safe, unmarked shell (ExternalExec::Deny, docs/gate-and-shell-split.md
# "Slice 3" — this used to be the mutating grant before the 2026-08-17 flag
# day; kept explicit rather than implied). `facade:shell_write` is the hot,
# mutating twin (ExternalExec::Allow, what this grant alone used to mean) —
# JUDGMENT CALL (Amy should confirm): granted here because director is the
# operator's console and wants the safe tool available by default AND the hot
# one on hand, not because "director" is inherently a write-shell role.
# `edit_input` covers write_input too.
kj binding allow "facade:shell"
kj binding allow "facade:shell_write"
kj binding allow "facade:edit_input"
kj binding allow "facade:submit_input"
# The app's MIDI ear commits capture batches against its seat (docs/midi.md
# M2); a director seat can host the ear. Musician/toolie stay capture-mute.
kj binding allow "facade:commit_capture"
