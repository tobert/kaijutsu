# Admit one phrase for a fixed future tick on this attachment's track.
# The scheduler snapshots KJ_TRACK, KJ_TICK, KJ_PHRASE_BEATS, KJ_TEMPO,
# KJ_PHRASE, KJ_HEARD, KJ_COST_MS, KJ_LEAD_BEATS and KJ_OPEN_WORK before
# starting this lifecycle. A late script cannot move its target forward.
# Missed or invalid output uses the last good phrase.
#
# KJ_UNCOVERED, from the context env, says what plays at the phrases before a
# target more than one phrase ahead: `repeat` (the default) places a
# `kj transport repeat` at each of them, so the transport plays this
# performer's last phrase there; `silence` places nothing. Any other value
# fails this script, even while work is open.
#
# KJ_LISTEN, from the context env, names a track to listen to. When set, the
# tick renders that track's last phrase with `kj audio render` and appends the
# clip to this context as an audio block before it drives, so a model that
# reads audio hears what the track just played. A track that committed nothing
# in that phrase is skipped quietly. Any other render failure does not stop the
# phrase: the tick still drives, then ends with status 1 and the cause, so the
# player keeps playing and the failure is on record. Unset, nothing changes.
#
# One phrase is open at a time. While this performer still has unsettled work
# on the track (KJ_OPEN_WORK above 0), the tick admits nothing and ends with
# status 0. A repeat is not open work.
#
# The target is far enough ahead for the performer's measured cost:
# KJ_LEAD_BEATS is that cost times the safety factor, in beats. The target is
# KJ_TICK plus one phrase, plus one more phrase for each whole phrase of lead.
# A lead under one phrase, or no measured cost (0), targets one phrase ahead.
# In 4/4, each quarter-note beat contributes one fourth of a bar.
set -e
uncovered="${KJ_UNCOVERED:-repeat}"
case "$uncovered" in
  repeat|silence) ;;
  *)
    echo "tick: KJ_UNCOVERED is '$uncovered'; use repeat (play the last phrase at each uncovered phrase) or silence"
    exit 1
    ;;
esac
if [[ "$KJ_OPEN_WORK" -gt 0 ]]; then
  echo "tick: $KJ_OPEN_WORK phrase(s) still open on $KJ_TRACK; no new turn"
  exit 0
fi
listen_failed=""
if [[ -n "$KJ_LISTEN" ]]; then
  heard="$(kj audio render --track "$KJ_LISTEN" --phrases 1 --json 2>&1 || true)"
  case "$heard" in
    *"committed nothing"*)
      echo "tick: nothing committed on $KJ_LISTEN in the last phrase; not listening"
      ;;
    *'"hash"'*)
      clip="$(echo "$heard" | jq -r '.hash')"
      kj block create --role asset --kind text --content-type audio/wav --content "$clip"
      ;;
    *)
      listen_failed="$heard"
      ;;
  esac
fi
bars=$(( KJ_PHRASE_BEATS / 4 ))
phrases=$(( KJ_LEAD_BEATS / KJ_PHRASE_BEATS + 1 ))
target=$(( KJ_TICK + phrases * KJ_PHRASE_BEATS ))
kj drive --track "$KJ_TRACK" --score-at "$target" --fallback last-good --prompt "Commit at tick $target. Transport: tick $KJ_TICK, phrase $KJ_PHRASE, $KJ_TEMPO BPM, 4/4. Recently played (oldest to newest JSON): $KJ_HEARD. Play the next phrase, continuing seamlessly from what we just played. Write $KJ_PHRASE_BEATS beats with L:1/4: one beat per bare note or chord, a barline | every 4 beats, $bars bars total, so the line is continuous with no gap. Do not add duration numbers (no C2, no C/2) and do not pack multiple notes into a beat. Your header and register come from your chair. Emit one complete ABC tune: that header, then the body. Raw ABC only, with no prose and no code fences."
if [[ "$uncovered" = "repeat" ]] && [[ "$phrases" -gt 1 ]]; then
  for i in $(seq 1 $(( phrases - 1 ))); do
    kj transport repeat --track "$KJ_TRACK" --at "$(( KJ_TICK + i * KJ_PHRASE_BEATS ))"
  done
fi
if [[ -n "$listen_failed" ]]; then
  echo "tick: drove without listening; kj audio render --track $KJ_LISTEN failed: $listen_failed"
  exit 1
fi
