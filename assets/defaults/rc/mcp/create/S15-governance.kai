# mcp: producer / orchestrator governance grants.
#
# The `mcp` context_type is where most orchestration / producer work happens —
# Claude Code drives kaijutsu over MCP (cheap on the Anthropic subscription),
# while kaijutsu itself runs local / cheaper models to keep API spend down. That
# producer role iterates on the kernel's own config-as-code, so it
# holds the config governance cap *on top of* the broad loadout composed in
# by S10 (the shared `lib` binding: "*", facade:*, drive/fork/drift/transport/
# operator). /config/rc carries no capability of its own — file:write/edit
# (already in the shared loadout) reach it like any other file.
#
# config-write is deny-by-default and NOT implied by "*": a broad role must not
# be able to swap which model runs by accident. Granting it here is the
# explicit, intentional opt-in for the producer voice.
set -e
kj binding allow "config-write"  # kj config set/reset over /config/kernel, plus
                                 # kj backend/cast/alias (which model runs)
kj binding allow "system"        # kj system ps/status, and the stopping verbs

# `system` is here and NOT in the shared lib binding on purpose. It is the
# authority to see and stop the instrument, which a seat doing ordinary work
# (coder, musician) has no business holding -- it drifts the question instead.
# The producer seat holds it because it is the OUTSIDE hand: after a seppuku
# the kernel returns quiesced, kaijutsu's own agents must not bring it back,
# and a human or an external agent over MCP must be able to
# (docs/system-verbs.md).
