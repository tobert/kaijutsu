# Static x86_64 build toolchain for kaijutsu-server and kaijutsu-acp, for
# benchmark task containers that never see a package manager. This image
# carries no source: build-static.sh bind-mounts the worktree read-only and
# drives `cargo build` itself, so CARGO_HOME/CARGO_TARGET_DIR can live on
# real disk outside the container and survive between runs.
#
# On this base image the host target is already x86_64-unknown-linux-musl,
# and musl targets default target-feature=+crt-static — ordinary `cargo
# build --release` here already produces static binaries. build-static.sh
# still sets RUSTFLAGS="-C target-feature=+crt-static" explicitly and
# verifies the result with `file`/`ldd` rather than trusting the default.
FROM docker.io/library/rust:1.97-alpine3.22

RUN apk add --no-cache build-base capnproto-dev cmake git
