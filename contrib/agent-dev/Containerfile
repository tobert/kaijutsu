# The agent development image: a Kaijutsu kernel, its bridges, and kaibo, on Arch with build tools.
# The base is a layer from ~/src/homelab-arch-containers (arch-rocm by default; build.sh takes KJ_DEV_BASE), at the
# host's exact package versions, so binaries built on the host run here unchanged. build.sh stages them into the
# build context.
ARG BASE=localhost/arch-rocm:latest
FROM ${BASE}
ARG USER_NAME
ARG KAIJUTSU_COMMIT

# The build has no network: layer-install reads the host's pacman cache and the primed cache that build.sh mounts.
# Prime them first with homelab-arch-containers' scripts/prime.sh contrib/agent-dev/packages.
COPY packages /tmp/packages
RUN layer-install /tmp/packages && rm /tmp/packages

COPY kaijutsu-server kaijutsu-mcp kaijutsu-acp kaibo kaijutsu-run /usr/local/bin/

# The kernel's state is a mount at /var/lib/kaijutsu. HOME stays the host user's home, so `~/src/...` paths in
# project docs resolve to the read-only ~/src mount.
ENV HOME=/home/${USER_NAME} \
    XDG_CACHE_HOME=/var/lib/kaijutsu/cache \
    XDG_CONFIG_HOME=/var/lib/kaijutsu/config \
    XDG_DATA_HOME=/var/lib/kaijutsu/data \
    XDG_STATE_HOME=/var/lib/kaijutsu/state \
    XDG_RUNTIME_DIR=/tmp/kaijutsu-runtime \
    GIT_CONFIG_GLOBAL=/var/lib/kaijutsu/gitconfig \
    KAIJUTSU_COMMIT=${KAIJUTSU_COMMIT}
LABEL kaijutsu.commit="${KAIJUTSU_COMMIT}"

USER ${USER_NAME}
WORKDIR /workspace
EXPOSE 2222
# kaijutsu-run runs the kernel from /var/lib/kaijutsu/bin, so a binary update needs no new image.
ENTRYPOINT ["/usr/local/bin/kaijutsu-run"]
CMD ["--port", "2222"]
