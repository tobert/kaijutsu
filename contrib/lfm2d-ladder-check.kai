# Exercises the ordinal-ladder verdict derivation from
# `assets/defaults/rc/lib/create/S50-lfm2d.kai` against canned /v1/models
# bodies. Contacts no service, touches no kernel, and runs anywhere kaish does:
#
#     kaish contrib/lfm2d-ladder-check.kai     # exits 0, or 1 naming the case
#
# `check` RETURNS non-zero and the caller accumulates. It does not `exit`:
# kaish runs `exit` inside a function body without stopping the script, so an
# exiting check prints FAIL and still leaves the script at 0 — a test that
# cannot fail. Verified against kaish 0.16.
#
# The hook itself cannot be unit-tested — it runs inside a live kernel behind a
# gate — so this covers the two decisions in it that a wrong answer makes
# silent: which verdict a label earns from its position on the ladder, and
# which calls skip scoring entirely as `kj` help invocations.
#
# Keep it in step with the hook. If either rule there changes, this file
# changes with it. Two cases must never pass: the v6 inversion, and
# `--content --help`.
fails=0

check() {
  # $1 label, $2 expected verdict, $3 models body, $4 model id
  c_label="$1"
  expected="$2"
  models_resp="$3"
  model_id="$4"
  benign_label="informative"
  label_count=3
  c_verdict="escalate"
  c_index="$(echo $models_resp | jq -r --arg id $model_id --arg lbl $c_label '(map(select(.id == $id)) | .[0].labels // []) as $labels | ($labels | index($lbl)) // -1')"
  if [[ "$c_index" -eq 0 ]]; then
    if [[ "$c_label" = "$benign_label" ]]; then
      c_verdict="allow"
    fi
  elif [[ "$c_index" -eq $((label_count - 1)) ]]; then
    c_verdict="deny"
  fi
  if [[ "$c_verdict" = "$expected" ]]; then
    echo "ok   $model_id $c_label (index $c_index) -> $c_verdict"
  else
    echo "FAIL $model_id $c_label (index $c_index) -> $c_verdict, expected $expected"
    return 1
  fi
}

# A severity-ordered ladder, which is what every checkpoint from v8 on ships.
v10='[{"id":"kube_ordinal_v10","labels":["informative","situation-normal","data-critical"]}]'
check informative      allow    "$v10" kube_ordinal_v10 || fails=1
check situation-normal escalate "$v10" kube_ordinal_v10 || fails=1
check data-critical    deny     "$v10" kube_ordinal_v10 || fails=1
# A label the ladder does not carry resolves to index -1 and must escalate.
# Reaching `allow` here is the failure that reads as no gate at all.
check bogus-label      escalate "$v10" kube_ordinal_v10 || fails=1

# kube_ordinal_v6 is a live rollback target and orders its labels
# ALPHABETICALLY, which puts the most destructive one at index 0. Position
# alone would auto-allow exactly the commands the hook exists to catch; the
# benign-name match is what stops it. This case is the regression guard for
# the fail-open that shipped and was fixed in d2ce85ed.
v6='[{"id":"kube_ordinal_v6","labels":["data-critical","informative","situation-normal"]}]'
check data-critical    escalate "$v6" kube_ordinal_v6 || fails=1
check informative      escalate "$v6" kube_ordinal_v6 || fails=1

# --- the help bypass ---------------------------------------------------
#
# A call whose every clause is a `kj` help invocation is not scored: clap
# resolves help before dispatch, so nothing runs. The predicate is narrow on
# purpose and the `--content --help` case is why. `kj rc edit`'s content field
# is `allow_hyphen_values`, so clap binds `--help` as the VALUE and performs a
# real write — a word-scan for `--help` anywhere would auto-allow it.

sp=" "
dash="-"
help_filter="$(cat <<'HELP_FILTER_EOF'
[ .[] | .clause | (. / $sp) as $w
  | ( ($w|length) >= 2
      and ($w[0] == $kj)
      and (($w[-1] == ($dash + $dash + $help)) or ($w[-1] == ($dash + ($help[0:1]))))
      and (($w[1:-1] | map(select(startswith($dash))) | length) == 0) ) ] | all
HELP_FILTER_EOF
)"

check_help() {
  # $1 items JSON, $2 expected, $3 description
  items="$1"
  expected="$2"
  what="$3"
  got="$(echo $items | jq -r --arg sp $sp --arg dash $dash --arg kj kj --arg help help $help_filter)"
  if [[ "$got" = "$expected" ]]; then
    echo "ok   help: $what -> $got"
  else
    echo "FAIL help: $what -> $got, expected $expected"
    return 1
  fi
}

check_help '[{"clause":"kj rc edit --help"}]' true "kj rc edit --help" || fails=1
check_help '[{"clause":"kj ledger list --help"}]' true "kj ledger list --help" || fails=1
check_help '[{"clause":"kj -h"}]' true "kj -h" || fails=1
check_help '[{"clause":"kj rc rm /etc/rc/coder/create/S00.kai --help"}]' true "positional then --help" || fails=1
check_help '[{"clause":"kj rc edit --help"},{"clause":"kj rc rm --help"}]' true "two help clauses" || fails=1
# The bypass. This one must stay false.
check_help '[{"clause":"kj rc edit /etc/rc/x --content --help"}]' false "--content --help is a WRITE, not help" || fails=1
check_help '[{"clause":"kj rc rm /etc/rc/x"}]' false "a real rm" || fails=1
check_help '[{"clause":"cargo test --help"}]' false "not kj, not covered" || fails=1
check_help '[{"clause":"kj rc edit --help"},{"clause":"kj rc rm /etc/rc/x"}]' false "mixed: one real clause scores the call" || fails=1
check_help '[{"clause":"kj"}]' false "bare kj" || fails=1

if [[ "$fails" -ne 0 ]]; then
  echo "ladder check FAILED"
  exit 1
fi
echo "all ladder and help cases pass"
