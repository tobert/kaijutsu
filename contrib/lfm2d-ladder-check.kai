# Exercises the ordinal-ladder verdict derivation from
# `assets/defaults/rc/lib/hooks/lfm2d.kai` against canned /v1/models
# bodies. Contacts no service, touches no kernel, and runs anywhere kaish does:
#
#     kaish contrib/lfm2d-ladder-check.kai     # exits 0, or 1 naming the case
#
# `check` RETURNS non-zero and the caller accumulates. It does not `exit`:
# kaish runs `exit` inside a function body without stopping the script, so an
# exiting check prints FAIL and still leaves the script at 0 — a test that
# cannot fail. Verified against kaish 0.16.
#
# The hook itself cannot be unit-tested — it runs inside a live kernel behind a
# gate — so this covers the two decisions in it that a wrong answer makes
# silent: which verdict a label earns from its position on the ladder, and
# which calls skip scoring entirely as `kj` help invocations.
#
# Keep it in step with the hook. If either rule there changes, this file
# changes with it. Two cases must never pass: the v6 inversion, and
# `--content --help`.
fails=0

check() {
  # $1 label, $2 expected verdict, $3 models body, $4 model id
  c_label="$1"
  expected="$2"
  models_resp="$3"
  model_id="$4"
  benign_label="informative"
  label_count=3
  c_verdict="escalate"
  c_index="$(echo $models_resp | jq -r --arg id $model_id --arg lbl $c_label '(map(select(.id == $id)) | .[0].labels // []) as $labels | ($labels | index($lbl)) // -1')"
  if [[ "$c_index" -eq 0 ]]; then
    if [[ "$c_label" = "$benign_label" ]]; then
      c_verdict="allow"
    fi
  elif [[ "$c_index" -eq $((label_count - 1)) ]]; then
    c_verdict="deny"
  fi
  if [[ "$c_verdict" = "$expected" ]]; then
    echo "ok   $model_id $c_label (index $c_index) -> $c_verdict"
  else
    echo "FAIL $model_id $c_label (index $c_index) -> $c_verdict, expected $expected"
    return 1
  fi
}

# A severity-ordered ladder, which is what every checkpoint from v8 on ships.
v10='[{"id":"kube_ordinal_v10","labels":["informative","situation-normal","data-critical"]}]'
check informative      allow    "$v10" kube_ordinal_v10 || fails=1
check situation-normal escalate "$v10" kube_ordinal_v10 || fails=1
check data-critical    deny     "$v10" kube_ordinal_v10 || fails=1
# A label the ladder does not carry resolves to index -1 and must escalate.
# Reaching `allow` here is the failure that reads as no gate at all.
check bogus-label      escalate "$v10" kube_ordinal_v10 || fails=1

# kube_ordinal_v6 is a live rollback target and orders its labels
# ALPHABETICALLY, which puts the most destructive one at index 0. Position
# alone would auto-allow exactly the commands the hook exists to catch; the
# benign-name match is what stops it. This case is the regression guard for
# the fail-open that shipped and was fixed in d2ce85ed.
v6='[{"id":"kube_ordinal_v6","labels":["data-critical","informative","situation-normal"]}]'
check data-critical    escalate "$v6" kube_ordinal_v6 || fails=1
check informative      escalate "$v6" kube_ordinal_v6 || fails=1

# --- the scoring exemptions --------------------------------------------
#
# A call whose every clause is exempt is not scored. Two exemptions, both
# requiring `kj` as the first word AND no redirect.
#
#   1. `kj ... --help`. clap resolves help before dispatch, so nothing runs.
#      The predicate is narrow on purpose and the `--content --help` case is
#      why: `kj rc add`'s content field is `allow_hyphen_values`, so clap
#      binds `--help` as the VALUE and performs a real write — a word-scan
#      for `--help` anywhere would auto-allow it.
#   2. `kj ledger ...`, the gate's own answer path. Scoring it deadlocked the
#      gate. Safe only because a seat can no longer answer its own ask
#      (docs/gate-and-shell-split.md, "No self-approval").
#
# `has_redirect` gates both. A redirect makes any command a filesystem
# write, and the clause text cannot show it: `kj ledger list` and `kj ledger
# list > ~/.bashrc` render the SAME clause, so only the field tells them
# apart. It comes from kaish's own `commands[].redirects`, never a scan for
# `>`. An absent field reads as no redirect, which is what the rows below
# that omit it rely on.
#
# THIS FILTER IS A COPY of the one in
# assets/defaults/rc/lib/hooks/lfm2d.kai. Keeping this file free of
# kernel, config and network is what lets another lane run it, and that is
# worth a duplicated predicate — but the two must be changed together, or
# this gate tests something the hook no longer does.

sp=" "
dash="-"
exempt_filter="$(cat <<'EXEMPT_FILTER_EOF'
[ .[] as $it | ($it.clause / $sp) as $w
  | ( ($w|length) >= 2
      and ($w[0] == $kj)
      and ($it.has_redirect != true)
      and ( ( (($w[-1] == ($dash + $dash + $help)) or ($w[-1] == ($dash + ($help[0:1]))))
              and (($w[1:-1] | map(select(startswith($dash))) | length) == 0) )
            or ($w[1] == $ledger) ) ) ] | all
EXEMPT_FILTER_EOF
)"

check_exempt() {
  # $1 items JSON, $2 expected, $3 description
  items="$1"
  expected="$2"
  what="$3"
  got="$(echo $items | jq -r --arg sp $sp --arg dash $dash --arg kj kj --arg help help --arg ledger ledger $exempt_filter)"
  if [[ "$got" = "$expected" ]]; then
    echo "ok   exempt: $what -> $got"
  else
    echo "FAIL exempt: $what -> $got, expected $expected"
    return 1
  fi
}

check_exempt '[{"clause":"kj rc add --help"}]' true "kj rc add --help" || fails=1
check_exempt '[{"clause":"kj ledger list --help"}]' true "kj ledger list --help" || fails=1
check_exempt '[{"clause":"kj -h"}]' true "kj -h" || fails=1
check_exempt '[{"clause":"kj rc rm /config/rc/coder/create/S00.kai --help"}]' true "positional then --help" || fails=1
check_exempt '[{"clause":"kj rc add --help"},{"clause":"kj rc rm --help"}]' true "two help clauses" || fails=1
# The bypass. This one must stay false.
check_exempt '[{"clause":"kj rc add /config/rc/x --content --help"}]' false "--content --help is a WRITE, not help" || fails=1
check_exempt '[{"clause":"kj rc rm /config/rc/x"}]' false "a real rm" || fails=1
check_exempt '[{"clause":"cargo test --help"}]' false "not kj, not covered" || fails=1
check_exempt '[{"clause":"kj rc add --help"},{"clause":"kj rc rm /config/rc/x"}]' false "mixed: one real clause scores the call" || fails=1
check_exempt '[{"clause":"kj"}]' false "bare kj" || fails=1

# The gate's own answer path. Every `kj ledger` verb is exempt, because the
# no-self-approval check — not a score — is what keeps `allow`/`deny` honest.
check_exempt '[{"clause":"kj ledger allow 01a03b0f"}]' true "kj ledger allow" || fails=1
check_exempt '[{"clause":"kj ledger deny 01a03b0f"}]' true "kj ledger deny" || fails=1
check_exempt '[{"clause":"kj ledger show 01a03b0f"}]' true "kj ledger show" || fails=1
check_exempt '[{"clause":"kj ledger list"}]' true "kj ledger list" || fails=1
check_exempt '[{"clause":"kj ledger allow a"},{"clause":"kj ledger deny b"}]' true "two ledger clauses" || fails=1
# Narrowness: the exemption is the WORD `ledger` in position 1, not a prefix,
# and not after any first word.
check_exempt '[{"clause":"kj ledgerfoo bar"}]' false "ledgerfoo is not ledger" || fails=1
check_exempt '[{"clause":"notkj ledger allow x"}]' false "first word must be kj" || fails=1
check_exempt '[{"clause":"kj ledger list"},{"clause":"kj rc rm /config/rc/x"}]' false "mixed: a real clause scores the call" || fails=1

# A redirect makes any command a filesystem write. These clause STRINGS are
# identical to exempt ones above — the field is the only difference, which
# is the whole reason it exists.
check_exempt '[{"clause":"kj ledger list","has_redirect":true}]' false "ledger list with a redirect is a write" || fails=1
check_exempt '[{"clause":"kj ledger list","has_redirect":false}]' true "ledger list without one still exempt" || fails=1
check_exempt '[{"clause":"kj rc add --help","has_redirect":true}]' false "help with a redirect is a write" || fails=1
check_exempt '[{"clause":"kj ledger allow a"},{"clause":"kj ledger deny b","has_redirect":true}]' false "one redirected clause scores the call" || fails=1

# --- the tier rules -----------------------------------------------------
#
# The kernel's gate policy evaluator stamps each KJ_TOOL_PLAN command with a
# tier -- allow, ask, deny, or score (docs/gate-policy-tuning.md,
# "Verdicts"). `deny` never reaches a hook. Two rules, both load-bearing:
#
#   1. Ask tier is firm. An ask-tier clause is never re-scored by the
#      classifier -- it exits (escalate mode) or logs (log mode) before
#      lfm2d is even contacted, naming the FIRST ask-tier clause found.
#   2. Allow tier is dropped from the scored set, so a mixed call (`kj
#      block list; rm -rf /tmp/x`) does not send its already-allowed read
#      clause back through the classifier. A clause with no `tier` field at
#      all -- the KJ_TOOL_PLAN-unavailable fallback -- is NOT dropped: only
#      an explicit `allow` is.
#
# THESE FILTERS ARE COPIES of the ones in
# assets/defaults/rc/lib/hooks/lfm2d.kai and must change together, exactly
# like the exemption filter comment above says.

check_ask() {
  # $1 items JSON, $2 expected clause ("" for none), $3 description
  items="$1"
  expected="$2"
  what="$3"
  got="$(echo $items | jq -r --arg t ask 'map(select(.tier == $t)) | if length > 0 then .[0].clause else empty end')"
  if [[ "$got" = "$expected" ]]; then
    echo "ok   ask: $what -> '$got'"
  else
    echo "FAIL ask: $what -> '$got', expected '$expected'"
    return 1
  fi
}

check_ask '[{"clause":"kj rc add x","tier":"ask"}]' "kj rc add x" "one ask-tier item detects it" || fails=1
check_ask '[{"clause":"kj block list","tier":"allow"},{"clause":"rm -rf /tmp/x","tier":"score"}]' "" "no ask-tier item yields empty" || fails=1
check_ask '[{"clause":"a","tier":"score"},{"clause":"b","tier":"ask"},{"clause":"c","tier":"ask"}]' "b" "the FIRST ask-tier clause wins" || fails=1

check_allow_drop() {
  # $1 items JSON, $2 expected filtered items JSON, $3 description
  items="$1"
  expected="$2"
  what="$3"
  got="$(echo $items | jq -c --arg t allow '[.[] | select(.tier != $t)]')"
  if [[ "$got" = "$expected" ]]; then
    echo "ok   allow-drop: $what -> $got"
  else
    echo "FAIL allow-drop: $what -> $got, expected $expected"
    return 1
  fi
}

check_allow_drop '[{"clause":"kj block list","tier":"allow"}]' '[]' "allow item dropped" || fails=1
check_allow_drop '[{"clause":"a","tier":"score"}]' '[{"clause":"a","tier":"score"}]' "score item kept" || fails=1
check_allow_drop '[{"clause":"a","tier":"ask"}]' '[{"clause":"a","tier":"ask"}]' "ask item kept" || fails=1
check_allow_drop '[{"clause":"a"}]' '[{"clause":"a"}]' "item with no tier field is NOT dropped -- the fallback path" || fails=1
check_allow_drop '[{"clause":"a","tier":"allow"},{"clause":"b","tier":"score"}]' '[{"clause":"b","tier":"score"}]' "mixed allow+score keeps exactly the score item" || fails=1

if [[ "$fails" -ne 0 ]]; then
  echo "ladder check FAILED"
  exit 1
fi
echo "all ladder and exemption cases pass"
